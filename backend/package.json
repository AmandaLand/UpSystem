{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/bundle.cjs --external:better-sqlite3",
    "pkg": "pkg dist/bundle.cjs --targets node20-win-x64 --output ../release/upsystem.exe"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.3",
    "fastify": "^5.1.0",
    "open": "^10.1.0",
    "systeminformation": "^5.23.5",
    "trash": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@yao-pkg/pkg": "^6.2.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
